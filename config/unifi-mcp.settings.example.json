{
  "$schema": "https://example.invalid/unifi-mcp.settings.schema.json",
  "tokenRefreshSkew": "00:02:00",
  "server": {
    "name": "unifi-mcp",
    "protocolVersion": "2024-11-05",
    "allowRawResponses": false,
    "maxCollectionItems": 25,
    "maxObjectProperties": 12,
    "maxStringLength": 256,
    "maxUpstreamResponseBytes": 1048576,
    "maxStdioMessageBytes": 1048576,
    "maxSanitizedOutputCharacters": 32768,
    "maxJsonDepth": 12,
    "maxRequestBodyBytes": 262144,
    "mutationApprovalKeyEnvironmentVariable": "UNIFI_MCP_MUTATION_APPROVAL_KEY",
    "mutationApprovalMaxAgeSeconds": 300,
    "maxOperationSchemaCharacters": 131072
  },
  "credentials": [
    {
      "name": "site-manager-key",
      "apiKeyEnvironmentVariable": "UNIFI_SITE_MANAGER_API_KEY",
      "apiKeyHeaderName": "X-API-KEY"
    },
    {
      "name": "network-key",
      "apiKeyEnvironmentVariable": "UNIFI_NETWORK_API_KEY",
      "apiKeyHeaderName": "X-API-KEY"
    },
    {
      "name": "protect-key",
      "apiKeyEnvironmentVariable": "UNIFI_PROTECT_API_KEY",
      "apiKeyHeaderName": "X-API-KEY"
    },
    {
      "name": "access-token",
      "apiKeyEnvironmentVariable": "UNIFI_ACCESS_API_TOKEN",
      "apiKeyHeaderName": "Authorization",
      "apiKeyValuePrefix": "Bearer"
    },
    {
      "name": "mobility-key",
      "apiKeyEnvironmentVariable": "UNIFI_MOBILITY_API_KEY",
      "apiKeyHeaderName": "X-API-KEY"
    }
  ],
  "scopes": [
    {
      "name": "site-manager",
      "baseAddress": "https://api.ui.com",
      "service": "siteManager",
      "credential": "site-manager-key",
      "scopeDescription": "UniFi Site Manager inventory and health reads.",
      "sessionTtl": "00:55:00",
      "allowMutations": true,
      "allowedHttpMethods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "allowConnectorProxy": true,
      "connectorAllowedPathPrefixes": [
        "/proxy/network/integration/v1"
      ],
      "allowedRelativePathPrefixes": [
        "/v1"
      ]
    },
    {
      "name": "network",
      "baseAddress": "https://unifi/proxy/network/integration",
      "service": "network",
      "credential": "network-key",
      "scopeDescription": "UniFi Network API reads for a controller or connector scope.",
      "sessionTtl": "00:55:00",
      "allowMutations": true,
      "allowedHttpMethods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "allowedRelativePathPrefixes": [
        "/v1"
      ]
    },
    {
      "name": "protect",
      "baseAddress": "https://unifi/proxy/protect/integration",
      "service": "protect",
      "credential": "protect-key",
      "scopeDescription": "UniFi Protect device inventory reads.",
      "sessionTtl": "00:55:00",
      "allowMutations": false,
      "allowedHttpMethods": [
        "GET"
      ],
      "allowedRelativePathPrefixes": [
        "/v1"
      ]
    },
    {
      "name": "access",
      "baseAddress": "https://unifi:12445",
      "service": "access",
      "credential": "access-token",
      "scopeDescription": "UniFi Access door and device reads.",
      "sessionTtl": "00:55:00",
      "allowMutations": false,
      "allowedHttpMethods": [
        "GET"
      ],
      "allowedRelativePathPrefixes": [
        "/api/v1/developer"
      ]
    },
    {
      "name": "mobility",
      "baseAddress": "https://api.ui.com",
      "service": "mobility",
      "credential": "mobility-key",
      "scopeDescription": "UniFi Mobility workspace and device reads.",
      "sessionTtl": "00:55:00",
      "allowMutations": false,
      "allowedHttpMethods": [
        "GET"
      ],
      "allowedRelativePathPrefixes": [
        "/v1/mobility"
      ]
    }
  ]
}
