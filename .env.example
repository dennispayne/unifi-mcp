# Copy this file to .env for local development only.
# Do not commit real controller details or credentials.

# Optional explicit config path. If omitted, the hosts look for:
#   1. config\unifi-mcp.settings.json
#   2. unifi-mcp.settings.json
UNIFI_MCP_CONFIG=

# Referenced by config\unifi-mcp.settings.example.json.
UNIFI_SITE_MANAGER_API_KEY=
UNIFI_NETWORK_API_KEY=

# Optional HTTP transport settings.
UNIFI_MCP_HTTP_URLS=http://127.0.0.1:8765
UNIFI_MCP_HTTP_AUTH_TOKEN=
UNIFI_MCP_HTTP_ALLOWED_ORIGINS=
