{
  "$schema": "https://example.invalid/unifi-mcp.guardrails.schema.json",
  "auth": {
    "credentialSource": "environment",
    "allowCredentialEcho": false
  },
  "tooling": {
    "defaultResponseMode": "summary",
    "allowRawResponses": false,
    "defaultPageSize": 25,
    "maxPageSize": 100,
    "requireScopeFiltersForLargeQueries": true,
    "mutationToolsEnabled": true,
    "requireExplicitMutationConfirmation": true
  },
  "redaction": {
    "headers": [
      "Authorization",
      "Cookie",
      "Set-Cookie",
      "X-CSRF-Token",
      "X-API-Key"
    ],
    "valueKeys": [
      "token",
      "accessToken",
      "refreshToken",
      "password",
      "secret",
      "clientSecret",
      "privateKey",
      "session",
      "cookie"
    ],
    "maskIdentifiersByDefault": [
      "ip",
      "mac",
      "serial",
      "email",
      "hostname"
    ]
  },
  "logging": {
    "logRequestBodies": false,
    "logResponseBodies": false,
    "logPromptPayloads": false
  },
  "leastPrivilege": {
    "defaultRole": "least-privilege",
    "smallestPracticalScope": true,
    "separateWriteIdentity": true
  }
}
